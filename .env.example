# NVIDIA Build model selected from the low-traffic tool-calling options.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# Optional override if the extracted dataset is outside the repository root.
ZENTROMART_DATASET_DIR=

# Gnani Vachana key for Prisma STT and Timbre TTS.
GNANI_API_KEY=
